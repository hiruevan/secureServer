# ============================================
# CRITICAL SECURITY KEYS (REQUIRED)
# ============================================
# Generate secure keys with this command:
# python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# note that these should not be stored in this .env file for production systems
# instead, set them as environment variables in your server environment

# Main system encryption key (REQUIRED - minimum 32 characters)
#SYSTEM_KEY=REPLACE_WITH_SECURE_KEY_HERE

# Data integrity verification key (REQUIRED - minimum 32 characters)
#INTEGRITY_KEY=REPLACE_WITH_SECURE_KEY_HERE

# Encapsulation encryption key (REQUIRED - minimum 32 characters)
#ENCAPSILATION_KEY=REPLACE_WITH_SECURE_KEY_HERE

# Token encryption key (REQUIRED - minimum 32 characters)
#TOKEN_KEY=REPLACE_WITH_SECURE_KEY_HERE

# ==========================================
# APPLICATION
# ==========================================

APP_NAME=Secure Vault

# ==========================================
# SERVER
# ==========================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

HTTPS_HOST=0.0.0.0
HTTPS_PORT=443

# ==========================================
# SSL / HTTPS
# ==========================================

SSL_CERT_FILE=
SSL_KEY_FILE=
SSL_CIPHERS=TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256

# ==========================================
# ALLOWED HOSTS
# ==========================================

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.1.23

# ==========================================
# SECURITY
# ==========================================

USE_HTTPS=false

LOCKOUT_LOGIN_WINDOW=900
PW_CHANGE_AUTH_WINDOW=120

MAX_LOGIN_FAILURES=5

AUTH_TOKEN_AGE=900
REFRESH_TOKEN_AGE=172800

# ==========================================
# DEBUGGING
# ==========================================

REPLACE_CORRUPTED_FILES=true